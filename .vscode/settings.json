{
    "cSpell.words": [
        "schedulability",
        "posedge",
        "endcase",
        "endmodule",
        "verilator",
        "cocotb"
    ],

    "files.associations": {
        "*.v": "verilog",
        "*.vh": "verilog",
        "*.sv": "systemverilog",
        "*.svh": "systemverilog"
    },

    // Settings configuration for the Nolte parser engine
    "verilog.compiler.linter": "verilator",
    "verilog.compiler.verilator.path": "/usr/local/bin/verilator",
    "verilog.compiler.verilator.arguments": "--lint-only -Wall -I${workspaceFolder}/hw_ip/open_source_ip",
    "verilog.compiler.verilator.runAt": "onSave"
}
