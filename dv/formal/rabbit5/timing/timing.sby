# rabbit5 timing properties.  Run from dv/formal/rabbit5:  make timing
# (the Makefile writes ../build/slang_load.ys, which loads the slang plugin
#  only on Yosys builds where it is not built in)
[tasks]
bmc
cover

[options]
bmc:   mode bmc
cover: mode cover
depth 24

[engines]
smtbmc boolector

[script]
script slang_load.ys
read_slang rabbit5_pkg.sv rabbit5_decoder.sv rabbit5_alu.sv rabbit5_regfile.sv rabbit5_csr.sv rabbit5_core.sv rabbit5_timing_tb.sv --top rabbit5_timing_tb -DSYNTHESIS
prep -top rabbit5_timing_tb

[files]
../build/slang_load.ys
../../../../rtl/cores/rabbit5/rabbit5_pkg.sv
../../../../rtl/cores/rabbit5/rabbit5_decoder.sv
../../../../rtl/cores/rabbit5/rabbit5_alu.sv
../../../../rtl/cores/rabbit5/rabbit5_regfile.sv
../../../../rtl/cores/rabbit5/rabbit5_csr.sv
../../../../rtl/cores/rabbit5/rabbit5_core.sv
rabbit5_timing_tb.sv
